# DEV-ONLY values for local Docker Compose. Replace every secret outside a demo.
POSTGRES_DB=car_damage
POSTGRES_USER=car_damage
POSTGRES_PASSWORD=car_damage

# Must contain at least 32 UTF-8 bytes. Never use this value in production.
JWT_SECRET=dev-only-jwt-secret-change-me-32-bytes

ADMIN_EMAIL=admin@localhost
# Demo login: admin@localhost / admin123
ADMIN_PASSWORD_HASH=$2a$10$GCMQ8.9DazsbGn3GcB3SY.GYV6luXY3OyzEgwm4S5qeNbzoNa8Zkq

# mock is the default and does not need an OpenAI key
AI_PROVIDER=mock
# Set AI_PROVIDER=openai and provide a real key only for a local integration check.
# OPENAI_API_KEY=

APP_PORT=8080
